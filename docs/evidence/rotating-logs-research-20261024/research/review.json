  "minimal_contract": {
    "crate": "implemented rustusb-logging shared by CLI/helper/service; no filesystem in core and no daemon/service cycle",
    "compatibility": "default stderr stays; trusted opt-in private directory. Existing machine stdout remains logging-free.",
    "commands": [
      "rustusb logs --agent-config /etc/rustusb/agent.json --profile PROFILE [--after CURSOR] [--json] [--follow]",
      "rustusb logs --helper (root-only fixed helper store, no arbitrary path RPC)"
    ],
    "dto": [
      "LogRecordV1",
      "LogStatus",
      "LogPage",
      "ReadLogs",
      "opaque Cursor",
      "LogStoreOwner::shutdown -> actual writer result"
    ],
    "defaults": {
      "record_bytes": 2048,
      "queue_records": 256,
      "segment_bytes": 4194304,
      "total_segments": 8,
      "page_records": 16,
      "page_output_bytes": 32768,
      "page_scan_bytes": 262144,
      "read_concurrency": 2,
      "directory_mode": "0700",
      "file_mode": "0600"
    },
    "redaction": "Allowlisted typed event codes and scalar fields only; static Failure category plus optional errno; never persist arbitrary tracing message/Debug/Display, Device, raw USB, keys/certs/config or subprocess stderr. Human rendering from same typed records.",
    "audit": "Mirror typed AuditEvent only after successful authoritative Store commit, preserve audit_seq/epoch; gaps allowed; never ACK admission or replace state WAL/proof.",
    "restart": "Exclusive checked owner; validate bounded old segments; fresh epoch and segment. Preserve torn old tail as reported gap, no append onto partial JSON; runtime failure remains unhealthy without silent auto reopen.",
    "cursor": "Generated segment UUID + complete-record offset, no paths and no authorization capability; current OS UID/profile authorization applies before each read; retention/replacement produces gap/refusal.",
    "failure_shutdown": "bounded nonblocking producer; worker real I/O errors visible; actual USB cleanup and required state WAL first, then drain/join writer. Hard-blocked filesystem cannot be cancelled/proven joined. Logger status independent from journal_healthy and USB cleanup."
  },
