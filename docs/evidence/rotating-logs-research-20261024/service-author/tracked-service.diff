+    Worker,
+    /// Logging lost records; business work may nevertheless have succeeded.
+    LostRecords,
+}
+
+impl From<&rustusb_logging::Error> for LogReadFailure {
+    fn from(error: &rustusb_logging::Error) -> Self {
