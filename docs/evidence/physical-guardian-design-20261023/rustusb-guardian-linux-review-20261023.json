  "facts": [
    {
      "id": "independent_open",
      "path": "devio.c",
      "lines": "1032-1087",
      "conclusion": "Each independent open has separate usb_dev_state; B is independent recovery authority, not A completion/release authority.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "last_release",
      "path": "devio.c",
      "lines": "1089-1123;660-700",
      "conclusion": "A release holds USB device lock, releases A claims and kills all A async URBs; it does not reconnect remembered drivers.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "safe_claim",
      "path": "devio.c + driver.c",
      "lines": "779-850;538-596",
      "conclusion": "Plain claim rejects any existing driver with EBUSY; it cannot steal A/C but is a mutation.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "safe_CONNECT_not_driver_selection",
      "path": "devio.c",
      "lines": "2316-2370",
      "conclusion": "CONNECT probes only an unbound interface; existing driver is EBUSY. No original-driver selector exists.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "parent_lock",
      "path": "devio.c + driver.c",
      "lines": "2596-2615;2034-2039",
      "conclusion": "Ioctl device lock and USB bus parent-lock policy protect the actual ownership check/action, not permanent userspace exclusion.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "configuration",
      "path": "devio.c + message.c",
      "lines": "1543-1589;2186-2214",
      "conclusion": "All currently bound interfaces, including B, block SETCONFIG; successful configuration installs/probes interfaces and may claim siblings/change alt.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "alternate_release",
      "path": "devio.c + driver.c",
      "lines": "1526-1541;431-517",
      "conclusion": "SETINTERFACE auto-claims; usbfs release/unbind normally returns alt0, so None+nonzero-alt is not solved by temporary claim/set/release.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "async_control_scope",
      "path": "devio.c",
      "lines": "1615-1687;457-470;2040-2127",
      "conclusion": "EP0 may use ifnum=-1; per-interface cleanup and B reaping cannot certify/consume old A device-level work.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "DROP_limit",
      "path": "devio.c",
      "lines": "779-795;878-934;1499-1523;2316-2328;2460-2493;2534-2550",
      "conclusion": "DROP is partial attenuation: mask excludes future claims but not already-owned, vendor/device control or general SETCONFIG; it blocks CONNECT and can break re-import lifecycle.",
      "kind": "fixed-source fact / explicitly bounded inference"
    },
    {
      "id": "exit_order",
      "path": "kernel/exit.c + fs/file_table.c",
      "lines": "866-891;425-447",
      "conclusion": "Known controlled file-table references can be sequenced with wait/last keeper close; delayed fput and untracked references remain explicit boundaries, not reasons to abandon the controlled experiment.",
      "kind": "fixed-source fact / explicitly bounded inference"
    }
  ],
