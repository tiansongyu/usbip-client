{
  "schema_version": 1,
  "broker_uid": 2000,
  "helper_socket": "/run/rustusb/control.sock",
  "control_directory": "/run/agent",
  "data_directory": "/var/lib/rustusb/agent",
  "profiles": [
    {
      "id": "pool",
      "backend": "usbfs",
      "config": "/etc/rustusb/server-pool.json"
    }
  ],
  "operators": [
    {
      "uid": 1000,
      "profiles": [
        "pool"
      ],
      "actions": [
        "read",
        "start",
        "stop",
        "discover",
        "audit"
      ]
    }
  ]
}
