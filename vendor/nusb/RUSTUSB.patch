+#[cfg(target_os = "linux")]
+impl<EpType: BulkOrInterrupt, Dir: EndpointDirection> Endpoint<EpType, Dir> {
+    /// Submit a Linux URB with the exact requested IN length, including zero.
+    ///
+    /// Unlike the portable method, this allows lengths smaller than or not
+    /// divisible by MPS. The kernel receives the original length: no extra USB
+    /// bytes are read, cached, or discarded. Each buffer is limited to 64KiB.
+    /// SHORT_NOT_OK is valid only for IN, ZERO_PACKET only for bulk OUT.
+    /// DMA ownership flags from a remote host must never be passed here.
+    #[cfg(target_os = "linux")]
+    pub fn submit_raw(
+        &mut self,
+        buf: Buffer,
+        short_not_ok: bool,
+        zero_packet: bool,
+    ) -> Result<(), Error> {
+        if buf.requested_len() > 65_536
+            || buf.len() > 65_536
+            || (short_not_ok && Dir::DIR != Direction::In)
+            || (zero_packet
+                && (Dir::DIR != Direction::Out
+                    || EpType::TYPE != crate::descriptors::TransferType::Bulk))
+        {
+            return Err(Error::new(
+                ErrorKind::Unsupported,
+                "unsupported raw transfer options",
+            ));
+        }
+        let flags = u32::from(short_not_ok) | (u32::from(zero_packet) << 6);
+        self.backend.submit_raw(buf, flags);
+        Ok(())
+    }
+
+    /// Linux kernel status and partial bytes, also on failure/cancellation.
+    #[cfg(target_os = "linux")]
+    pub fn next_complete_raw(
+        &mut self,
+    ) -> impl Future<Output = Result<crate::RawCompletion, Error>> + '_ {
+        poll_fn(|cx| self.poll_complete_raw(cx))
+    }
+
+    /// Poll one Linux raw completion without borrowing a temporary future.
+    ///
+    /// No queued transfer is an error rather than a panic. Completion retains
+    /// the original errno and partial bytes, including after cancellation.
+    #[cfg(target_os = "linux")]
+    pub fn poll_complete_raw(
+        &mut self,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<crate::RawCompletion, Error>> {
+        if self.pending() == 0 {
+            return Poll::Ready(Err(Error::new(ErrorKind::Other, "no raw transfer pending")));
+        }
+        self.backend.poll_next_complete_raw(cx).map(Ok)
+    }
+
