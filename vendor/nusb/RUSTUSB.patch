+impl<C, T> TransferFuture<C, T> {
+    pub(crate) fn cancel_with<R>(
+        &mut self,
+        cancel: impl FnOnce(&C, &mut Pending<T>) -> R,
+    ) -> Option<R> {
+        if let Some(transfer) = self.transfer.as_mut() {
+            if transfer.is_complete() {
+                return None;
+            }
+            return Some(cancel(&self.inner.context, transfer));
+        }
+        None
+    }
+}
