+
+enum RawControlContext {
+    Device(Arc<LinuxDevice>),
+    Interface(Arc<LinuxInterface>),
+}
+
+impl RawControlContext {
+    fn device(&self) -> &Arc<LinuxDevice> {
+        match self {
+            Self::Device(device) => device,
+            Self::Interface(interface) => &interface.device,
