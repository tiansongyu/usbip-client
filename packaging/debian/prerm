#!/bin/sh
set -eu
[ -z "${DPKG_ROOT:-}" ] || { echo 'RustUSB: alternate DPKG_ROOT is unsupported' >&2; exit 1; }
case "$1" in
  remove|upgrade|failed-upgrade|deconfigure)
    echo "RustUSB: verifying cooperative process stop before $1"
    test -f /usr/libexec/rustusb/package-control || { echo 'RustUSB: installed lifecycle gate missing; package files retained' >&2; exit 1; }
    /usr/bin/python3 -I /usr/libexec/rustusb/package-control stop
    ;;
  *) echo 'RustUSB: unsupported prerm operation' >&2; exit 1 ;;
esac
